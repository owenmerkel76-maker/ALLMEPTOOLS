<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROBMEPTOOLS - Tag + Dim Organizer"
        Width="900" Height="650" MinWidth="820" MinHeight="600"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#07131F" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#07131F"/>
    <SolidColorBrush x:Key="Sidebar" Color="#071725"/>
    <SolidColorBrush x:Key="Header" Color="#091A29"/>
    <SolidColorBrush x:Key="Footer" Color="#081624"/>
    <SolidColorBrush x:Key="Card" Color="#091C2B"/>
    <SolidColorBrush x:Key="Input" Color="#0C2233"/>
    <SolidColorBrush x:Key="HoverStrong" Color="#17344C"/>
    <SolidColorBrush x:Key="Border" Color="#234963"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#35607B"/>
    <SolidColorBrush x:Key="Text" Color="#F2F7FA"/>
    <SolidColorBrush x:Key="TextSoft" Color="#D6E4EC"/>
    <SolidColorBrush x:Key="TextMuted" Color="#7897AA"/>
    <SolidColorBrush x:Key="TextFaint" Color="#607F92"/>
    <SolidColorBrush x:Key="Accent" Color="#168CF3"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#55B8F4"/>
    <SolidColorBrush x:Key="AccentDark" Color="#0F4D79"/>
    <SolidColorBrush x:Key="Success" Color="#36D39A"/>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="ChoiceRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextSoft}"/><Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverStrong}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDark}"/>
            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextSoft}"/><Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverStrong}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource AccentSoft}"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinWidth" Value="150"/>
    </Style>
    <Style x:Key="ToggleStyle" TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextSoft}"/><Setter Property="Margin" Value="0,5,0,5"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Window.Resources>
  <Grid Background="{StaticResource Canvas}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="16,18,16,14"><StackPanel Orientation="Horizontal">
          <Border Width="40" Height="40" Background="#0D3E63" BorderBrush="#2D8CC9" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
            <TextBlock Text="TD" Foreground="#E8F6FF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="ROBMEPTOOLS" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="TAG + DIM ORGANIZER" Foreground="{StaticResource TextMuted}" FontSize="8.5"/></StackPanel>
        </StackPanel></StackPanel>
        <Border Grid.Row="1" Height="1" Background="{StaticResource Border}" Margin="14,0,14,12"/>
        <StackPanel Grid.Row="2" Margin="12,0,12,0">
          <Border Background="#0F4D79" BorderBrush="#55B8F4" BorderThickness="1" CornerRadius="7" Padding="12,10">
            <StackPanel><TextBlock Text="POST-PROCESS" Foreground="White" FontWeight="SemiBold" FontSize="10"/>
              <TextBlock Text="Run after AutoTag and AutoDim. Model MEP stays fixed; only annotation is reorganized." Foreground="#9FC1D5" FontSize="8.5" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="11"><StackPanel>
            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Success}" Margin="0,0,7,0" VerticalAlignment="Center"/>
              <TextBlock Text="BALANCED RECOMMENDED" Foreground="#B9CBD6" FontWeight="SemiBold" FontSize="8.5"/></StackPanel>
            <TextBlock Text="Reset dragged dimension text first, pull whole dimensions back toward their MEP host, then bank dimensions and clean tags." Foreground="{StaticResource TextFaint}" FontSize="8.2" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel></Border>
        </StackPanel>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="12,0,12,14" Padding="10"><StackPanel>
          <TextBlock Text="SAFETY" Foreground="#A6BDCB" FontWeight="SemiBold" FontSize="8.5"/>
          <TextBlock Text="Never moves Fab duct or pipe" Foreground="#62C8F3" FontSize="9" Margin="0,4,0,0"/>
          <TextBlock Text="Pinned and unsupported annotation is skipped." Foreground="{StaticResource TextFaint}" FontSize="8" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="22,13">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="Tag + Dim Organizer" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Clean annotation collisions without changing MEP geometry." Foreground="{StaticResource TextMuted}" FontSize="9.5" Margin="0,3,0,0"/></StackPanel>
          <Border Grid.Column="1" Background="#0C263B" BorderBrush="#2D6081" BorderThickness="1" CornerRadius="13" Padding="10,4" VerticalAlignment="Center">
            <TextBlock Name="ModeBadge" Text="BALANCED • ACTIVE VIEW" Foreground="#78D0FA" FontSize="9"/>
          </Border>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,16,20,16">
        <Border Style="{StaticResource CardStyle}"><StackPanel>
          <TextBlock Text="1. Cleanup strength" Foreground="#ECF5FA" FontSize="12" FontWeight="SemiBold"/>
          <TextBlock Text="Higher modes search farther, but still penalize unnecessary movement." Foreground="{StaticResource TextMuted}" FontSize="8.8" Margin="0,3,0,12"/>
          <StackPanel Orientation="Horizontal"><RadioButton Name="ModeConservative" GroupName="Mode" Content="CONSERVATIVE" Style="{StaticResource ChoiceRadio}"/>
            <RadioButton Name="ModeBalanced" GroupName="Mode" Content="BALANCED" Style="{StaticResource ChoiceRadio}" IsChecked="True"/>
            <RadioButton Name="ModeClean" GroupName="Mode" Content="CLEAN" Style="{StaticResource ChoiceRadio}"/></StackPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel>
          <TextBlock Text="2. Scope" Foreground="#ECF5FA" FontSize="12" FontWeight="SemiBold"/>
          <TextBlock Text="Selected Annotation moves only selected tags/dimensions but still treats everything else as an obstacle." Foreground="{StaticResource TextMuted}" FontSize="8.8" Margin="0,3,0,12"/>
          <StackPanel Orientation="Horizontal"><RadioButton Name="ScopeView" GroupName="Scope" Content="ACTIVE VIEW" Style="{StaticResource ChoiceRadio}" IsChecked="True"/>
            <RadioButton Name="ScopeSelection" GroupName="Scope" Content="SELECTED ANNOTATION" Style="{StaticResource ChoiceRadio}"/></StackPanel>
        </StackPanel></Border>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel>
            <TextBlock Text="3. Organize" Foreground="#ECF5FA" FontSize="12" FontWeight="SemiBold"/>
            <CheckBox Name="DoTags" Content="Tags + leaders" IsChecked="True" Style="{StaticResource ToggleStyle}"/>
            <CheckBox Name="DoDims" Content="Dimensions + dimension text" IsChecked="True" Style="{StaticResource ToggleStyle}"/>
            <CheckBox Name="MultiLeader" Content="Consolidate matching nearby MEP tags (multi-leader when supported)" IsChecked="True" Style="{StaticResource ToggleStyle}"/>
            <CheckBox Name="BankDims" Content="Bank parallel dimensions into consistent local lanes" IsChecked="True" Style="{StaticResource ToggleStyle}"/>
            <CheckBox Name="CompactDims" Content="Compact dimension witness lines toward referenced MEP" IsChecked="True" Style="{StaticResource ToggleStyle}"/>
            <CheckBox Name="ResetDimText" Content="Reset dragged dimension text / long text leaders first" IsChecked="True" Style="{StaticResource ToggleStyle}"/>
            <CheckBox Name="CleanShoulders" Content="Shorten long tag leader shoulders" IsChecked="True" Style="{StaticResource ToggleStyle}"/>
            <CheckBox Name="SecondPass" Content="Second cleanup pass" IsChecked="True" Style="{StaticResource ToggleStyle}"/>
          </StackPanel></Border>
          <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,0,0"><StackPanel>
            <TextBlock Text="4. Avoid" Foreground="#ECF5FA" FontSize="12" FontWeight="SemiBold"/>
            <CheckBox Name="AvoidDuct" Content="MEP Fabrication duct" IsChecked="True" Style="{StaticResource ToggleStyle}"/>
            <CheckBox Name="AvoidPipe" Content="MEP Fabrication pipe" IsChecked="True" Style="{StaticResource ToggleStyle}"/>
            <CheckBox Name="AvoidDwg" Content="Visible background DWGs" IsChecked="True" Style="{StaticResource ToggleStyle}"/>
            <CheckBox Name="Detailed" Content="Detailed console report" IsChecked="False" Style="{StaticResource ToggleStyle}"/>
          </StackPanel></Border>
        </Grid>
        <Border Background="#082436" BorderBrush="#2C5873" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,12,0,0">
          <TextBlock Name="HelpText" Text="Balanced: reset dimension text leaders, compact whole dimensions toward their MEP hosts, then bank dimensions and clean tags. DWG hatch/pattern layers stay soft." Foreground="#A9C4D4" FontSize="8.8" TextWrapping="Wrap"/>
        </Border>
      </StackPanel></ScrollViewer>
      <Border Grid.Row="2" Background="{StaticResource Footer}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="20,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Name="FooterHelp" Text="Active View scans visible annotation, Fabrication MEP, and the local DWG work zone." Foreground="{StaticResource TextMuted}" FontSize="8.8" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Name="CancelButton" Content="CANCEL" Style="{StaticResource ActionButton}"/>
          <Button Grid.Column="2" Name="RunButton" Content="ORGANIZE VIEW" Style="{StaticResource PrimaryButton}"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
