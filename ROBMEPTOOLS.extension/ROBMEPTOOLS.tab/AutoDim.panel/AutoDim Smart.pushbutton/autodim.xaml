<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROBMEPTOOLS - AutoDim Smart"
        Width="900" Height="710"
        MinWidth="820" MinHeight="640"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#07131F"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#07131F"/>
    <SolidColorBrush x:Key="Sidebar" Color="#071725"/>
    <SolidColorBrush x:Key="Header" Color="#091A29"/>
    <SolidColorBrush x:Key="Footer" Color="#081624"/>
    <SolidColorBrush x:Key="Card" Color="#091C2B"/>
    <SolidColorBrush x:Key="Input" Color="#0C2233"/>
    <SolidColorBrush x:Key="HoverStrong" Color="#17344C"/>
    <SolidColorBrush x:Key="Border" Color="#234963"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#35607B"/>
    <SolidColorBrush x:Key="Text" Color="#F2F7FA"/>
    <SolidColorBrush x:Key="TextSoft" Color="#D6E4EC"/>
    <SolidColorBrush x:Key="TextMuted" Color="#7897AA"/>
    <SolidColorBrush x:Key="TextFaint" Color="#607F92"/>
    <SolidColorBrush x:Key="Accent" Color="#168CF3"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#55B8F4"/>
    <SolidColorBrush x:Key="AccentDark" Color="#0F4D79"/>
    <SolidColorBrush x:Key="Success" Color="#36D39A"/>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="ChoiceRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
      <Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverStrong}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDark}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentSoft}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
      <Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverStrong}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentSoft}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinWidth" Value="132"/>
    </Style>

    <Style x:Key="ToggleStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource Canvas}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="205"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource Sidebar}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,18,16,14">
          <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" Background="#0D3E63"
                    BorderBrush="#2D8CC9" BorderThickness="1"
                    CornerRadius="8" Margin="0,0,10,0">
              <TextBlock Text="AD" Foreground="#E8F6FF" FontWeight="Bold"
                         FontSize="13" HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="ROBMEPTOOLS" Foreground="{StaticResource Text}"
                         FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Text="AUTODIM SMART" Foreground="{StaticResource TextMuted}"
                         FontSize="8.5"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource Border}"
                Margin="14,0,14,12"/>

        <StackPanel Grid.Row="2" Margin="12,0,12,0">
          <Border Background="#0F4D79" BorderBrush="#55B8F4"
                  BorderThickness="1" CornerRadius="7" Padding="12,10">
            <StackPanel>
              <TextBlock Text="SETUP" Foreground="White" FontWeight="SemiBold" FontSize="10"/>
              <TextBlock Text="Choose discipline and scope, then run one shared AutoDim workflow."
                         Foreground="#9FC1D5" FontSize="8.5" TextWrapping="Wrap"
                         Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="11">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{StaticResource Success}"
                         Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="ACTIVE VIEW RECOMMENDED"
                           Foreground="#B9CBD6" FontWeight="SemiBold" FontSize="8.5"/>
              </StackPanel>
              <TextBlock Text="AllRefs + strict connector-position fallback recover Fabrication connectivity without proximity-only target suppression."
                         Foreground="{StaticResource TextFaint}" FontSize="8.2"
                         TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="12,0,12,14" Padding="10">
          <StackPanel>
            <TextBlock Text="CURRENT CORE" Foreground="#A6BDCB" FontWeight="SemiBold" FontSize="8.5"/>
            <TextBlock Text="Duct v6.0 • Pipe v5.0"
                       Foreground="#62C8F3" FontSize="9" Margin="0,4,0,0"/>
            <TextBlock Text="One button • actual geometric coverage certification"
                       Foreground="{StaticResource TextFaint}" FontSize="8"
                       TextWrapping="Wrap" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="76"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="64"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource Header}"
              BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
              Padding="22,13">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="AutoDim Smart" Foreground="{StaticResource Text}"
                       FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Choose what to dimension and how much of the active view to process."
                       Foreground="{StaticResource TextMuted}" FontSize="9.5" Margin="0,3,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#0C263B" BorderBrush="#2D6081"
                  BorderThickness="1" CornerRadius="13" Padding="10,4"
                  VerticalAlignment="Center">
            <TextBlock Name="ModeBadge" Text="DUCT • ACTIVE VIEW"
                       Foreground="#78D0FA" FontSize="9"/>
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="1. What are you dimensioning?"
                         Foreground="#ECF5FA" FontSize="12" FontWeight="SemiBold"/>
              <TextBlock Text="One ribbon button now owns both AutoDim workflows."
                         Foreground="{StaticResource TextMuted}" FontSize="8.8"
                         Margin="0,3,0,12"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton Name="DisciplineDuct" GroupName="Discipline"
                             Content="DUCTWORK" Style="{StaticResource ChoiceRadio}"
                             IsChecked="True"/>
                <RadioButton Name="DisciplinePipe" GroupName="Discipline"
                             Content="PIPEWORK" Style="{StaticResource ChoiceRadio}"/>
                <RadioButton Name="DisciplineBoth" GroupName="Discipline"
                             Content="DUCT + PIPE" Style="{StaticResource ChoiceRadio}"/>
              </StackPanel>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#0A2233" BorderBrush="#244E68"
                        BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,6,0">
                  <StackPanel>
                    <TextBlock Text="DUCT RULE" Foreground="#7CCEF4" FontSize="8.5" FontWeight="SemiBold"/>
                    <TextBlock Text="Rectangular / oval = EDGE → grid&#x0a;Round = CENTER → grid"
                               Foreground="#C6D7E1" FontSize="9.5" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#0A2233" BorderBrush="#244E68"
                        BorderThickness="1" CornerRadius="6" Padding="11" Margin="6,0,0,0">
                  <StackPanel>
                    <TextBlock Text="PIPE RULE" Foreground="#7CCEF4" FontSize="8.5" FontWeight="SemiBold"/>
                    <TextBlock Text="Straight pipe = CENTER → grid&#x0a;Sloped pipe uses plan centerline"
                               Foreground="#C6D7E1" FontSize="9.5" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="2. Scope"
                         Foreground="#ECF5FA" FontSize="12" FontWeight="SemiBold"/>
              <TextBlock Text="Active View is the default so visible straights cannot be omitted just because they were never selected."
                         Foreground="{StaticResource TextMuted}" FontSize="8.8"
                         Margin="0,3,0,12" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton Name="ScopeView" GroupName="Scope"
                             Content="ACTIVE VIEW" Style="{StaticResource ChoiceRadio}"
                             IsChecked="True"/>
                <RadioButton Name="ScopeSelection" GroupName="Scope"
                             Content="CURRENT SELECTION" Style="{StaticResource ChoiceRadio}"/>
                <RadioButton Name="ScopePick" GroupName="Scope"
                             Content="PICK MANUALLY" Style="{StaticResource ChoiceRadio}"/>
              </StackPanel>

              <Border Background="#0B263A" BorderBrush="#28516B"
                      BorderThickness="1" CornerRadius="6" Padding="11"
                      Margin="0,14,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="WHY ACTIVE VIEW?"
                             Foreground="#79D2FA" FontSize="8.5"
                             FontWeight="SemiBold" Margin="0,0,12,0"/>
                  <TextBlock Grid.Column="1"
                             Text="The last Pipe test had 231 straight pipes in the selected scope. Active View lets us compare that against every visible straight pipe without relying on preselection."
                             Foreground="#9EB5C3" FontSize="8.5" TextWrapping="Wrap"/>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="3. Which grids may AutoDim use?"
                         Foreground="#ECF5FA" FontSize="12" FontWeight="SemiBold"/>
              <TextBlock Text="Prefer hand-picked drafting grids without giving up the original v2.3 coverage, or choose strict mode when you truly want only those grids."
                         Foreground="{StaticResource TextMuted}" FontSize="8.8"
                         Margin="0,3,0,12" TextWrapping="Wrap"/>
              <WrapPanel>
                <RadioButton Name="GridAll" GroupName="GridMode"
                             Content="ALL USABLE GRIDS" Style="{StaticResource ChoiceRadio}"
                             IsChecked="True"/>
                <RadioButton Name="GridPrefer" GroupName="GridMode"
                             Content="PREFER SELECTED GRIDS" Style="{StaticResource ChoiceRadio}"/>
                <RadioButton Name="GridStrict" GroupName="GridMode"
                             Content="SELECTED GRIDS ONLY" Style="{StaticResource ChoiceRadio}"/>
              </WrapPanel>
              <Border Background="#0B263A" BorderBrush="#28516B"
                      BorderThickness="1" CornerRadius="6" Padding="11"
                      Margin="0,14,0,0">
                <TextBlock Text="PREFER SELECTED GRIDS is the safe default for manual grid control: picked grids win when compatible, but uncovered targets fall back to the original v2.3 grid search. SELECTED GRIDS ONLY is strict and may intentionally leave targets undimensioned."
                           Foreground="#9EB5C3" FontSize="8.5" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="4. Results"
                         Foreground="#ECF5FA" FontSize="12" FontWeight="SemiBold"/>
              <TextBlock Text="Keep detailed diagnostics on while we eliminate the remaining misses."
                         Foreground="{StaticResource TextMuted}" FontSize="8.8"
                         Margin="0,3,0,8"/>
              <CheckBox Name="DetailedResults" Content="Show detailed AutoDim result window after run"
                        Style="{StaticResource ToggleStyle}" IsChecked="True"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{StaticResource Footer}"
              BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
              Padding="18,11">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Name="FooterTitle" Text="Ready to dimension."
                       Foreground="#BBD0DC" FontSize="9.5" FontWeight="SemiBold"/>
            <TextBlock Name="FooterHelp"
                       Text="Every surviving dimension is certified against its intended grid + measured target geometry before coverage is awarded."
                       Foreground="{StaticResource TextFaint}" FontSize="8.3"
                       Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Name="CancelButton" Content="Cancel" Style="{StaticResource ActionButton}"/>
            <Button Name="RunButton" Content="Run AutoDim" Style="{StaticResource PrimaryButton}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
