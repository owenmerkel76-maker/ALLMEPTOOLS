<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource RB.Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource RB.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14"/>
  </Style>

  <Style x:Key="NavGlyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="Foreground" Value="{DynamicResource RB.TextMuted}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="NavButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource RB.TextSoft}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="13,9"/>
    <Setter Property="Margin" Value="10,2"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource RB.Hover}"/><Setter Property="Foreground" Value="{DynamicResource RB.Text}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource RB.Focus}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
    <Setter Property="Background" Value="{DynamicResource RB.AccentDark}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="ActionButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource RB.TextSoft}"/>
    <Setter Property="Background" Value="{DynamicResource RB.Input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource RB.BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource RB.HoverStrong}"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource RB.Focus}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.42"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
    <Setter Property="Background" Value="{DynamicResource RB.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="FieldToggle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource RB.TextSoft}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Margin" Value="0,2,0,2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="8,5">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Border x:Name="Track" Grid.Column="1" Width="32" Height="17" CornerRadius="9" Background="#314755" BorderBrush="#4B6270" BorderThickness="1" Margin="10,0,0,0">
                <Ellipse x:Name="Knob" Width="11" Height="11" Fill="#A9BBC6" HorizontalAlignment="Left" Margin="2,0,0,0"/>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RB.Hover}"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RB.Focus}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource RB.Accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/><Setter TargetName="Knob" Property="Fill" Value="White"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GroupButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
    <Setter Property="Padding" Value="12,7"/><Setter Property="MinWidth" Value="88"/><Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style x:Key="GroupButtonActive" TargetType="Button" BasedOn="{StaticResource GroupButton}">
    <Setter Property="Background" Value="{DynamicResource RB.AccentDark}"/><Setter Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Background" Value="#0B1C2B"/>
  </Style>
  <Style x:Key="PresetButtonActive" TargetType="Button" BasedOn="{StaticResource PresetButton}">
    <Setter Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/><Setter Property="Background" Value="#0D263A"/>
  </Style>

  <Style x:Key="ChoiceRadio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource RB.TextSoft}"/><Setter Property="Background" Value="{DynamicResource RB.Input}"/><Setter Property="BorderBrush" Value="{DynamicResource RB.BorderStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource RB.HoverStrong}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource RB.Focus}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource RB.AccentDark}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="SwatchRadio" TargetType="RadioButton">
    <Setter Property="Width" Value="27"/><Setter Property="Height" Value="27"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid><Ellipse x:Name="Outer" Fill="#0B1C2B" Stroke="#4B6B7F" StrokeThickness="1"/><Ellipse x:Name="ColorDot" Margin="4" Fill="{TemplateBinding Background}"/><Ellipse x:Name="Ring" Margin="1" Stroke="Transparent" StrokeThickness="2"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource RB.Focus}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource RB.Focus}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="White"/><Setter TargetName="Ring" Property="StrokeThickness" Value="2.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="SearchTextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource RB.Text}"/>
    <Setter Property="Background" Value="{DynamicResource RB.Input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource RB.BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="CaretBrush" Value="{DynamicResource RB.AccentSoft}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SemanticBadge" TargetType="Border">
    <Setter Property="Width" Value="58"/><Setter Property="Height" Value="58"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="#103551"/><Setter Property="BorderBrush" Value="#2A6F99"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="MiniBadge" TargetType="Border" BasedOn="{StaticResource SemanticBadge}"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="BadgeText" TargetType="TextBlock"><Setter Property="Foreground" Value="#DFF3FF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="11"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="TagBorder" TargetType="Border"><Setter Property="Background" Value="#0B2B40"/><Setter Property="BorderBrush" Value="#28516B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0,0,6,0"/></Style>

  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource RB.Text}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="PageHelp" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource RB.TextMuted}"/><Setter Property="FontSize" Value="9.5"/><Setter Property="Margin" Value="0,3,0,0"/></Style>
  <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#ECF5FA"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="CardHelp" TargetType="TextBlock"><Setter Property="Foreground" Value="#7996A8"/><Setter Property="FontSize" Value="8.8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
</ResourceDictionary>
