<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROBMEPTOOLS - AutoTag Smart"
        Width="980" Height="720" MinWidth="900" MinHeight="650"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#07131F" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#07131F"/><SolidColorBrush x:Key="Sidebar" Color="#071725"/>
    <SolidColorBrush x:Key="Header" Color="#091A29"/><SolidColorBrush x:Key="Footer" Color="#081624"/>
    <SolidColorBrush x:Key="Card" Color="#091C2B"/><SolidColorBrush x:Key="Input" Color="#0C2233"/>
    <SolidColorBrush x:Key="HoverStrong" Color="#17344C"/><SolidColorBrush x:Key="Border" Color="#234963"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#35607B"/><SolidColorBrush x:Key="Text" Color="#F2F7FA"/>
    <SolidColorBrush x:Key="TextSoft" Color="#D6E4EC"/><SolidColorBrush x:Key="TextMuted" Color="#9EB5C3"/>
    <SolidColorBrush x:Key="TextFaint" Color="#7897AA"/><SolidColorBrush x:Key="Accent" Color="#168CF3"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#55B8F4"/><SolidColorBrush x:Key="AccentDark" Color="#0F4D79"/>
    <SolidColorBrush x:Key="Success" Color="#36D39A"/>
    <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="Foreground" Value="#A8BDC9"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#0F4D79"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="ChoiceRadio" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource TextSoft}"/><Setter Property="Background" Value="{StaticResource Input}"/><Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverStrong}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDark}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="CheckStyle" TargetType="CheckBox"><Setter Property="Foreground" Value="#E4EEF3"/><Setter Property="Margin" Value="0,6"/><Setter Property="FontSize" Value="10.5"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F9FC"/><Setter Property="Background" Value="#0C2233"/><Setter Property="Padding" Value="9,7"/><Setter Property="FontSize" Value="10.5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBd" Property="Background" Value="#173F5B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBd" Property="Background" Value="#0F4D79"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ComboStyle" TargetType="ComboBox"><Setter Property="Foreground" Value="#102331"/><Setter Property="Background" Value="#E8F1F5"/><Setter Property="BorderBrush" Value="#5E88A0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="10.5"/><Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}"/></Style>
    <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Foreground" Value="#E6F0F5"/><Setter Property="FontSize" Value="10.5"/><Setter Property="Background" Value="#0C2233"/><Setter Property="BorderBrush" Value="#35607B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#168CF3"/><Setter Property="BorderBrush" Value="#55B8F4"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Grid Background="{StaticResource Canvas}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="16,18,16,14"><StackPanel Orientation="Horizontal"><Border Width="40" Height="40" Background="#0D3E63" BorderBrush="#2D8CC9" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0"><TextBlock Text="AT" Foreground="#E8F6FF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="ROBMEPTOOLS" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="AUTOTAG SMART" Foreground="{StaticResource TextMuted}" FontSize="9"/></StackPanel></StackPanel></StackPanel>
        <Border Grid.Row="1" Height="1" Background="{StaticResource Border}" Margin="14,0,14,12"/>
        <StackPanel Grid.Row="2" Margin="12,0"><Button Name="NavOverview" Content="Overview" Style="{StaticResource NavButtonActive}"/><Button Name="NavTargets" Content="Targets" Style="{StaticResource NavButton}"/><Button Name="NavTags" Content="Tag Types" Style="{StaticResource NavButton}"/><Button Name="NavPlacement" Content="Placement" Style="{StaticResource NavButton}"/></StackPanel>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="12,0,12,14" Padding="10"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Success}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="ONE SHARED WORKFLOW" Foreground="#B9CBD6" FontWeight="SemiBold" FontSize="8.5"/></StackPanel><TextBlock Text="Duct V9 + Pipe V1. Existing event detection stays separate; one menu controls both." Foreground="{StaticResource TextFaint}" FontSize="8.5" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="22,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="AutoTag Smart" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Choose Duct, Pipe, or Both; map BOD/BOP and component tags once; run from one button." Foreground="{StaticResource TextMuted}" FontSize="9.5" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Background="#0C263B" BorderBrush="#2D6081" BorderThickness="1" CornerRadius="13" Padding="10,4" VerticalAlignment="Center"><TextBlock Name="ModeBadge" Text="DUCT • BALANCED" Foreground="#78D0FA" FontSize="9.5"/></Border></Grid></Border>
      <Grid Grid.Row="1" Margin="20,16,20,14">
        <ScrollViewer Name="PageOverview" VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="1. What are you tagging?" Foreground="#ECF5FA" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Matches the AutoDim workflow: one ribbon button owns both disciplines." Foreground="{StaticResource TextMuted}" FontSize="8.8" Margin="0,3,0,12"/><StackPanel Orientation="Horizontal"><RadioButton Name="DisciplineDuct" GroupName="Discipline" Content="DUCTWORK" Style="{StaticResource ChoiceRadio}" IsChecked="True"/><RadioButton Name="DisciplinePipe" GroupName="Discipline" Content="PIPEWORK" Style="{StaticResource ChoiceRadio}"/><RadioButton Name="DisciplineBoth" GroupName="Discipline" Content="DUCT + PIPE" Style="{StaticResource ChoiceRadio}"/></StackPanel></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel><TextBlock Text="2. AutoTag profile" Foreground="#ECF5FA" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Presets apply to the active discipline(s). Manual changes clear the highlight instead of showing a false preset." Foreground="{StaticResource TextMuted}" FontSize="8.8" Margin="0,3,0,12" TextWrapping="Wrap"/><UniformGrid Columns="4"><Button Name="ProfileEvents" Style="{StaticResource ActionButton}" Content="EVENTS ONLY"/><Button Name="ProfileCD" Style="{StaticResource ActionButton}" Content="MEP CD"/><Button Name="ProfileComponents" Style="{StaticResource ActionButton}" Content="COMPONENTS"/><Button Name="ProfileAll" Style="{StaticResource ActionButton}" Content="FULL COVERAGE"/></UniformGrid></StackPanel></Border>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="EVENT TRIGGERS" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="9"/><TextBlock Name="SummaryEvents" Text="5" Foreground="#6ED2FF" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="ACTIVE ACROSS SELECTED DISCIPLINES" Foreground="#9DB6C4" FontSize="8.5"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,0,0"><StackPanel><TextBlock Text="DIRECT COMPONENT CATEGORIES" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="9"/><TextBlock Name="SummaryComponents" Text="0" Foreground="#6ED2FF" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="ACTIVE ACROSS SELECTED DISCIPLINES" Foreground="#9DB6C4" FontSize="8.5"/></StackPanel></Border></Grid>
          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Event-tag workflow" Foreground="#ECF5FA" FontWeight="SemiBold" FontSize="11"/><TextBlock Name="EventSampleHelp" Text="Choose the BOD/BOP event tag type on Tag Types; no sample tag is required." Foreground="#C6D7E1" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="Every tag mapping can be set to NONE / SKIP. Enabled targets with NONE selected are intentionally skipped." Foreground="#91ADBC" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <ScrollViewer Name="PageTargets" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="What gets tagged?" Foreground="#ECF5FA" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Duct and Pipe keep independent target settings even when you run BOTH." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,3,0,14"/>
          <Border Name="DuctTargetsCard" Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="DUCT • BOD TARGETS" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="10"/><CheckBox Name="DuctAllStraights" Style="{StaticResource CheckStyle}" Content="All visible straight ducts (BOD)"/><CheckBox Name="DuctEventDirection" Style="{StaticResource CheckStyle}" Content="Direction changes"/><CheckBox Name="DuctEventElevation" Style="{StaticResource CheckStyle}" Content="Elevation changes"/><CheckBox Name="DuctEventSize" Style="{StaticResource CheckStyle}" Content="Size changes"/><CheckBox Name="DuctEventShape" Style="{StaticResource CheckStyle}" Content="Shape changes (rect / round / oval)"/><CheckBox Name="DuctEventEndcap" Style="{StaticResource CheckStyle}" Content="Capped ends — last straight before cap"/><CheckBox Name="DuctEventBranch" Style="{StaticResource CheckStyle}" Content="Branch takeoffs — first horizontal straight"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock Text="DUCT • DIRECT COMPONENTS" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="10"/><CheckBox Name="DuctComponentTransition" Style="{StaticResource CheckStyle}" Content="Transitions / reducers"/><CheckBox Name="DuctComponentTerminal" Style="{StaticResource CheckStyle}" Content="Air terminals / diffusers"/><CheckBox Name="DuctComponentEquipment" Style="{StaticResource CheckStyle}" Content="Mechanical equipment"/><CheckBox Name="DuctComponentAccessory" Style="{StaticResource CheckStyle}" Content="Duct accessories"/></StackPanel></Grid></Border>
          <Border Name="PipeTargetsCard" Style="{StaticResource CardStyle}" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="PIPE • STRAIGHT-RUN EVENTS" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="10"/><CheckBox Name="PipeEventDirection" Style="{StaticResource CheckStyle}" Content="Direction changes"/><CheckBox Name="PipeEventElevation" Style="{StaticResource CheckStyle}" Content="Elevation offsets"/><CheckBox Name="PipeEventSize" Style="{StaticResource CheckStyle}" Content="Diameter / size changes"/><CheckBox Name="PipeEventShape" Style="{StaticResource CheckStyle}" Content="Profile / size-shape changes"/><CheckBox Name="PipeEventEndcap" Style="{StaticResource CheckStyle}" Content="Capped ends — last straight before cap"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock Text="PIPE • DIRECT COMPONENTS" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="10"/><CheckBox Name="PipeComponentTransition" Style="{StaticResource CheckStyle}" Content="Transitions / reducers"/><CheckBox Name="PipeComponentTerminal" Style="{StaticResource CheckStyle}" Content="Plumbing fixtures"/><CheckBox Name="PipeComponentEquipment" Style="{StaticResource CheckStyle}" Content="Mechanical equipment"/><CheckBox Name="PipeComponentAccessory" Style="{StaticResource CheckStyle}" Content="Pipe accessories / valves"/><CheckBox Name="PipeComponentExtra" Style="{StaticResource CheckStyle}" Content="Plumbing equipment"/></StackPanel></Grid></Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel><TextBlock Text="PLACEMENT CONTRACT" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="9"/><TextBlock Text="Event tags keep the existing collision-aware engines. Direct component tags are center-of-host/no-leader for this test build, and any already-tagged host is skipped." Foreground="#B5CAD5" FontSize="9.7" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <ScrollViewer Name="PageTags" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Tag-family mapping" Foreground="#ECF5FA" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Only compatible loaded tag types are listed. Choose NONE / SKIP for any tag category you do not want on this run." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,3,0,14"/>
          <Border Name="DuctTagTypesCard" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="DUCTWORK TAG TYPES" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="BOD tag • straight duct targets" Foreground="#D4E3EA" FontSize="10.5" Margin="0,10,0,0"/><ComboBox Name="DuctEventTagCombo" Style="{StaticResource ComboStyle}"/><TextBlock Text="Transition / reducer tag" Foreground="#D4E3EA" FontSize="10.5" Margin="0,10,0,0"/><ComboBox Name="DuctTransitionTagCombo" Style="{StaticResource ComboStyle}"/><TextBlock Text="Air terminal / diffuser tag" Foreground="#D4E3EA" FontSize="10.5"/><ComboBox Name="DuctTerminalTagCombo" Style="{StaticResource ComboStyle}"/><TextBlock Text="Mechanical equipment tag" Foreground="#D4E3EA" FontSize="10.5"/><ComboBox Name="DuctEquipmentTagCombo" Style="{StaticResource ComboStyle}"/><TextBlock Text="Duct accessory tag" Foreground="#D4E3EA" FontSize="10.5"/><ComboBox Name="DuctAccessoryTagCombo" Style="{StaticResource ComboStyle}"/></StackPanel></Border>
          <Border Name="PipeTagTypesCard" Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel><TextBlock Text="PIPEWORK TAG TYPES" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="BOP event tag • straight pipe events" Foreground="#D4E3EA" FontSize="10.5" Margin="0,10,0,0"/><ComboBox Name="PipeEventTagCombo" Style="{StaticResource ComboStyle}"/><TextBlock Text="Transition / reducer tag" Foreground="#D4E3EA" FontSize="10.5" Margin="0,10,0,0"/><ComboBox Name="PipeTransitionTagCombo" Style="{StaticResource ComboStyle}"/><TextBlock Text="Plumbing fixture tag" Foreground="#D4E3EA" FontSize="10.5"/><ComboBox Name="PipeTerminalTagCombo" Style="{StaticResource ComboStyle}"/><TextBlock Text="Mechanical equipment tag" Foreground="#D4E3EA" FontSize="10.5"/><ComboBox Name="PipeEquipmentTagCombo" Style="{StaticResource ComboStyle}"/><TextBlock Text="Pipe accessory / valve tag" Foreground="#D4E3EA" FontSize="10.5"/><ComboBox Name="PipeAccessoryTagCombo" Style="{StaticResource ComboStyle}"/><TextBlock Text="Plumbing equipment tag" Foreground="#D4E3EA" FontSize="10.5"/><ComboBox Name="PipeExtraTagCombo" Style="{StaticResource ComboStyle}"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <ScrollViewer Name="PagePlacement" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Placement &amp; runtime" Foreground="#ECF5FA" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Shared controls map to the matching Duct V9 / Pipe V1 placement mode without changing detection." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,3,0,14"/>
          <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="1. PLACEMENT ENGINE" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="10"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><RadioButton Name="EngineBalanced" GroupName="Engine" Content="BALANCED" Style="{StaticResource ChoiceRadio}" IsChecked="True"/><RadioButton Name="EngineFast" GroupName="Engine" Content="FAST" Style="{StaticResource ChoiceRadio}"/><RadioButton Name="EngineClean" GroupName="Engine" Content="CLEAN" Style="{StaticResource ChoiceRadio}"/></StackPanel></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel><TextBlock Text="2. SCOPE" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Active View is recommended for complete visible coverage; Current Selection is useful for small tests." Foreground="{StaticResource TextMuted}" FontSize="8.8" Margin="0,3,0,10" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><RadioButton Name="ScopeView" GroupName="Scope" Content="ACTIVE VIEW" Style="{StaticResource ChoiceRadio}" IsChecked="True"/><RadioButton Name="ScopeSelection" GroupName="Scope" Content="CURRENT SELECTION" Style="{StaticResource ChoiceRadio}"/></StackPanel></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel><TextBlock Text="3. ADVANCED" Foreground="#79D2FA" FontWeight="SemiBold" FontSize="10"/><CheckBox Name="AllowDoglegs" Style="{StaticResource CheckStyle}" Content="Allow doglegs even when a straight leader is clear"/><CheckBox Name="ForceLeaders" Style="{StaticResource CheckStyle}" Content="Force leaders on event tags"/><CheckBox Name="ExtraCleanup" Style="{StaticResource CheckStyle}" Content="Run extra cleanup pass (slower)"/><CheckBox Name="DetailedReport" Style="{StaticResource CheckStyle}" Content="Detailed console diagnostics"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource Footer}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="18,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Ready to tag." Foreground="#BBD0DC" FontSize="9.5" FontWeight="SemiBold"/><TextBlock Name="FooterHelp" Text="5 event trigger(s) • ACTIVE VIEW" Foreground="{StaticResource TextFaint}" FontSize="8.8" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Name="CancelButton" Content="Cancel" Style="{StaticResource ActionButton}" MinWidth="90"/><Button Name="RunButton" Content="Run AutoTag" Style="{StaticResource PrimaryButton}" MinWidth="125"/></StackPanel></Grid></Border>
    </Grid>
  </Grid>
</Window>
