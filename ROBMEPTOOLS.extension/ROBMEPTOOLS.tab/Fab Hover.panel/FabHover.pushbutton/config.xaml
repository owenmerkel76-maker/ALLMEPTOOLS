<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="ROBMEPTOOLS - Fab Hover"
        Width="1160" Height="730"
        MinWidth="980" MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RB.Canvas}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
        <!-- ROBMEPTOOLS design tokens. Keep tool windows visually consistent by
             consuming these keys through DynamicResource instead of hard-coding. -->

        <SolidColorBrush x:Key="RB.Canvas" Color="#07131F"/>
        <SolidColorBrush x:Key="RB.Sidebar" Color="#071725"/>
        <SolidColorBrush x:Key="RB.Header" Color="#091A29"/>
        <SolidColorBrush x:Key="RB.Footer" Color="#081624"/>
        <SolidColorBrush x:Key="RB.Card" Color="#091C2B"/>
        <SolidColorBrush x:Key="RB.CardAlt" Color="#0B263A"/>
        <SolidColorBrush x:Key="RB.Input" Color="#0C2233"/>
        <SolidColorBrush x:Key="RB.Hover" Color="#102A3F"/>
        <SolidColorBrush x:Key="RB.HoverStrong" Color="#17344C"/>
        <SolidColorBrush x:Key="RB.Border" Color="#234963"/>
        <SolidColorBrush x:Key="RB.BorderStrong" Color="#35607B"/>
        <SolidColorBrush x:Key="RB.Text" Color="#F2F7FA"/>
        <SolidColorBrush x:Key="RB.TextSoft" Color="#D6E4EC"/>
        <SolidColorBrush x:Key="RB.TextMuted" Color="#7897AA"/>
        <SolidColorBrush x:Key="RB.TextFaint" Color="#607F92"/>
        <SolidColorBrush x:Key="RB.Accent" Color="#168CF3"/>
        <SolidColorBrush x:Key="RB.AccentSoft" Color="#55B8F4"/>
        <SolidColorBrush x:Key="RB.AccentDark" Color="#0F4D79"/>
        <SolidColorBrush x:Key="RB.Success" Color="#36D39A"/>
        <SolidColorBrush x:Key="RB.Warning" Color="#E8BC64"/>
        <SolidColorBrush x:Key="RB.Danger" Color="#E65454"/>
        <SolidColorBrush x:Key="RB.Focus" Color="#7BCDF6"/>

        <sys:Double x:Key="RB.Radius.Card">8</sys:Double>
        <sys:Double x:Key="RB.Radius.Control">6</sys:Double>
        <GridLength x:Key="RB.Sidebar.Width">214</GridLength>
        <GridLength x:Key="RB.Header.Height">76</GridLength>
        <GridLength x:Key="RB.Footer.Height">60</GridLength>
        <sys:Double x:Key="RB.Space.XS">4</sys:Double>
        <sys:Double x:Key="RB.Space.SM">8</sys:Double>
        <sys:Double x:Key="RB.Space.MD">12</sys:Double>
        <sys:Double x:Key="RB.Space.LG">16</sys:Double>
        <sys:Double x:Key="RB.Space.XL">22</sys:Double>
        <!-- Standard Windows navigation/action glyphs only. Domain-specific MEP cards
             intentionally use text badges (HVAC, PL, EQ, etc.) instead of invented icons. -->
        <sys:String x:Key="RB.Icon.Overview">&#xE80F;</sys:String>
        <sys:String x:Key="RB.Icon.Fields">&#xE8FD;</sys:String>
        <sys:String x:Key="RB.Icon.Presets">&#xE8B7;</sys:String>
        <sys:String x:Key="RB.Icon.Appearance">&#xE790;</sys:String>
        <sys:String x:Key="RB.Icon.Behavior">&#xE713;</sys:String>
        <sys:String x:Key="RB.Icon.Categories">&#xE8EC;</sys:String>
        <sys:String x:Key="RB.Icon.Advanced">&#xE712;</sys:String>
        <sys:String x:Key="RB.Icon.Search">&#xE721;</sys:String>
        <sys:String x:Key="RB.Icon.Clear">&#xE894;</sys:String>
        <Style x:Key="Card" TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource RB.Card}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource RB.Border}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="8"/>
          <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="NavGlyph" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
          <Setter Property="Foreground" Value="{DynamicResource RB.TextMuted}"/>
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="Width" Value="24"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
          <Setter Property="Foreground" Value="{DynamicResource RB.TextSoft}"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="13,9"/>
          <Setter Property="Margin" Value="10,2"/>
          <Setter Property="FontSize" Value="11.5"/>
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                  <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource RB.Hover}"/><Setter Property="Foreground" Value="{DynamicResource RB.Text}"/></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource RB.Focus}"/></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>

        <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
          <Setter Property="Background" Value="{DynamicResource RB.AccentDark}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
          <Setter Property="Foreground" Value="{DynamicResource RB.TextSoft}"/>
          <Setter Property="Background" Value="{DynamicResource RB.Input}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource RB.BorderStrong}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="Padding" Value="14,8"/>
          <Setter Property="Margin" Value="0,0,8,0"/>
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource RB.HoverStrong}"/><Setter Property="Foreground" Value="White"/></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource RB.Focus}"/></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.42"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
          <Setter Property="Background" Value="{DynamicResource RB.Accent}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="FieldToggle" TargetType="CheckBox">
          <Setter Property="Foreground" Value="{DynamicResource RB.TextSoft}"/>
          <Setter Property="FontSize" Value="10.5"/>
          <Setter Property="Margin" Value="0,2,0,2"/>
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="CheckBox">
                <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="8,5">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="Track" Grid.Column="1" Width="32" Height="17" CornerRadius="9" Background="#314755" BorderBrush="#4B6270" BorderThickness="1" Margin="10,0,0,0">
                      <Ellipse x:Name="Knob" Width="11" Height="11" Fill="#A9BBC6" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                    </Border>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RB.Hover}"/><Setter Property="Foreground" Value="White"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RB.Focus}"/></Trigger>
                  <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource RB.Accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/><Setter TargetName="Knob" Property="Fill" Value="White"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>

        <Style x:Key="GroupButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
          <Setter Property="Padding" Value="12,7"/><Setter Property="MinWidth" Value="88"/><Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="GroupButtonActive" TargetType="Button" BasedOn="{StaticResource GroupButton}">
          <Setter Property="Background" Value="{DynamicResource RB.AccentDark}"/><Setter Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Background" Value="#0B1C2B"/>
        </Style>
        <Style x:Key="PresetButtonActive" TargetType="Button" BasedOn="{StaticResource PresetButton}">
          <Setter Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/><Setter Property="Background" Value="#0D263A"/>
        </Style>

        <Style x:Key="ChoiceRadio" TargetType="RadioButton">
          <Setter Property="Foreground" Value="{DynamicResource RB.TextSoft}"/><Setter Property="Background" Value="{DynamicResource RB.Input}"/><Setter Property="BorderBrush" Value="{DynamicResource RB.BorderStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource RB.HoverStrong}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource RB.Focus}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource RB.AccentDark}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource RB.AccentSoft}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SwatchRadio" TargetType="RadioButton">
          <Setter Property="Width" Value="27"/><Setter Property="Height" Value="27"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid><Ellipse x:Name="Outer" Fill="#0B1C2B" Stroke="#4B6B7F" StrokeThickness="1"/><Ellipse x:Name="ColorDot" Margin="4" Fill="{TemplateBinding Background}"/><Ellipse x:Name="Ring" Margin="1" Stroke="Transparent" StrokeThickness="2"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource RB.Focus}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource RB.Focus}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="White"/><Setter TargetName="Ring" Property="StrokeThickness" Value="2.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SearchTextBox" TargetType="TextBox">
          <Setter Property="Foreground" Value="{DynamicResource RB.Text}"/>
          <Setter Property="Background" Value="{DynamicResource RB.Input}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource RB.BorderStrong}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="Padding" Value="10,7"/>
          <Setter Property="CaretBrush" Value="{DynamicResource RB.AccentSoft}"/>
          <Setter Property="FontSize" Value="10.5"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SemanticBadge" TargetType="Border">
          <Setter Property="Width" Value="58"/><Setter Property="Height" Value="58"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="#103551"/><Setter Property="BorderBrush" Value="#2A6F99"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="MiniBadge" TargetType="Border" BasedOn="{StaticResource SemanticBadge}"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/><Setter Property="CornerRadius" Value="8"/></Style>
        <Style x:Key="BadgeText" TargetType="TextBlock"><Setter Property="Foreground" Value="#DFF3FF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="11"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="TagBorder" TargetType="Border"><Setter Property="Background" Value="#0B2B40"/><Setter Property="BorderBrush" Value="#28516B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0,0,6,0"/></Style>

        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource RB.Text}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="PageHelp" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource RB.TextMuted}"/><Setter Property="FontSize" Value="9.5"/><Setter Property="Margin" Value="0,3,0,0"/></Style>
        <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#ECF5FA"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="CardHelp" TargetType="TextBlock"><Setter Property="Foreground" Value="#7996A8"/><Setter Property="FontSize" Value="8.8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{DynamicResource RB.Canvas}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource RB.Sidebar.Width}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- SIDEBAR -->
    <Border Grid.Column="0" Background="{DynamicResource RB.Sidebar}" BorderBrush="{DynamicResource RB.Border}" BorderThickness="0,0,1,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="16,18,16,14">
          <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" Background="#0D3E63" BorderBrush="#2D8CC9" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0"><TextBlock Text="FH" Foreground="#E8F6FF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="ROBMEPTOOLS" Foreground="#F5FAFD" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="FAB HOVER" Foreground="#6F91A6" FontSize="8.5"/></StackPanel>
          </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Height="1" Background="#1C3B50" Margin="14,0,14,10"/>
        <StackPanel Grid.Row="2">
          <Button Name="NavOverview" Style="{StaticResource NavButtonActive}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource RB.Icon.Overview}" Style="{StaticResource NavGlyph}"/><TextBlock Grid.Column="1" Text="Overview" VerticalAlignment="Center"/></Grid></Button>
          <Button Name="NavFields" Style="{StaticResource NavButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource RB.Icon.Fields}" Style="{StaticResource NavGlyph}"/><TextBlock Grid.Column="1" Text="Display Fields" VerticalAlignment="Center"/></Grid></Button>
          <Button Name="NavPresets" Style="{StaticResource NavButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource RB.Icon.Presets}" Style="{StaticResource NavGlyph}"/><TextBlock Grid.Column="1" Text="Presets" VerticalAlignment="Center"/></Grid></Button>
          <Button Name="NavAppearance" Style="{StaticResource NavButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource RB.Icon.Appearance}" Style="{StaticResource NavGlyph}"/><TextBlock Grid.Column="1" Text="Appearance" VerticalAlignment="Center"/></Grid></Button>
          <Button Name="NavBehavior" Style="{StaticResource NavButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource RB.Icon.Behavior}" Style="{StaticResource NavGlyph}"/><TextBlock Grid.Column="1" Text="Behavior" VerticalAlignment="Center"/></Grid></Button>
          <Button Name="NavCategories" Style="{StaticResource NavButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource RB.Icon.Categories}" Style="{StaticResource NavGlyph}"/><TextBlock Grid.Column="1" Text="Categories" VerticalAlignment="Center"/></Grid></Button>
          <Button Name="NavAdvanced" Style="{StaticResource NavButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource RB.Icon.Advanced}" Style="{StaticResource NavGlyph}"/><TextBlock Grid.Column="1" Text="Advanced" VerticalAlignment="Center"/></Grid></Button>
        </StackPanel>
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="12,0,12,14" Padding="10">
          <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#33D69F" Margin="0,0,6,0"/><TextBlock Text="READY" Foreground="#B8CAD5" FontSize="8.5" FontWeight="SemiBold"/></StackPanel><TextBlock Text="HVAC + plumbing hover is configured here. Use Presets for quick setups or fine-tune individual fields." Foreground="#66879C" FontSize="8" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- MAIN -->
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="{DynamicResource RB.Header.Height}"/><RowDefinition Height="*"/><RowDefinition Height="{DynamicResource RB.Footer.Height}"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource RB.Header}" BorderBrush="{DynamicResource RB.Border}" BorderThickness="0,0,0,1" Padding="22,13">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Name="PageTitle" Text="Overview" Style="{StaticResource PageTitle}"/><TextBlock Name="PageSubtitle" Text="HVAC + plumbing quick-information setup." Style="{StaticResource PageHelp}"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#0C263B" BorderBrush="#2D6081" BorderThickness="1" CornerRadius="13" Padding="10,4" Margin="0,0,8,0"><TextBlock Name="SelectedText" Text="0 fields" Foreground="#78D0FA" FontSize="9"/></Border><Border Background="#0B1D2C" BorderBrush="#294B62" BorderThickness="1" CornerRadius="13" Padding="10,4"><TextBlock Text="Revit 2025" Foreground="#93A8B7" FontSize="9"/></Border></StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="20,16,20,14">
        <!-- OVERVIEW -->
        <ScrollViewer Name="PageOverview" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="MEP coverage" Foreground="#DCEAF2" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Text="A compact view of the disciplines Fab Hover is designed to read." Style="{StaticResource CardHelp}" Margin="0,2,0,10"/>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0" Padding="14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource SemanticBadge}" Margin="0,0,12,0"><TextBlock Text="HVAC" Style="{StaticResource BadgeText}"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="HVAC / Ductwork" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Ducts, fittings, fabrication, terminals, airflow and pressure data." Style="{StaticResource CardHelp}" Margin="0,3,0,7"/>
                    <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#36D39A" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Supported scope" Foreground="#79CFAE" FontSize="8.5"/></StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,3,0" Padding="14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource SemanticBadge}" Background="#103B43" BorderBrush="#2A7C82" Margin="0,0,12,0"><TextBlock Text="PIPE" Style="{StaticResource BadgeText}"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Plumbing / Hydronic" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Pipes, fittings, valves, fixtures, slope, flow and hydronic data." Style="{StaticResource CardHelp}" Margin="0,3,0,7"/>
                    <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#36D39A" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Supported scope" Foreground="#79CFAE" FontSize="8.5"/></StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource SemanticBadge}" Background="#2A2947" BorderBrush="#5B5A8A" Margin="0,0,12,0"><TextBlock Text="EQ" Style="{StaticResource BadgeText}"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Equipment" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Mechanical, water, specialty equipment and terminal information." Style="{StaticResource CardHelp}" Margin="0,3,0,7"/>
                    <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#36D39A" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Supported scope" Foreground="#79CFAE" FontSize="8.5"/></StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                <StackPanel>
                  <TextBlock Text="Current setup" Style="{StaticResource CardTitle}"/>
                  <TextBlock Text="Live summary of the settings that directly affect the hover reader and popup." Style="{StaticResource CardHelp}" Margin="0,2,0,10"/>
                  <UniformGrid Columns="4">
                    <Border Background="{DynamicResource RB.CardAlt}" BorderBrush="{DynamicResource RB.Border}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,6,0"><StackPanel><TextBlock Name="OverviewFieldCount" Text="0" Foreground="#6ED2FF" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="FIELDS" Foreground="#7998AA" FontSize="8"/></StackPanel></Border>
                    <Border Background="{DynamicResource RB.CardAlt}" BorderBrush="{DynamicResource RB.Border}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="2,0,4,0"><StackPanel><TextBlock Name="OverviewCategoryCount" Text="0" Foreground="#6ED2FF" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="CATEGORIES" Foreground="#7998AA" FontSize="8"/></StackPanel></Border>
                    <Border Background="{DynamicResource RB.CardAlt}" BorderBrush="{DynamicResource RB.Border}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="4,0,2,0"><StackPanel><TextBlock Name="OverviewPresetText" Text="Custom" Foreground="#EAF4F9" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="FIELD PRESET" Foreground="#7998AA" FontSize="8"/></StackPanel></Border>
                    <Border Background="{DynamicResource RB.CardAlt}" BorderBrush="{DynamicResource RB.Border}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="6,0,0,0"><StackPanel><TextBlock Name="OverviewThemeText" Text="Navy" Foreground="#EAF4F9" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="POPUP THEME" Foreground="#7998AA" FontSize="8"/></StackPanel></Border>
                  </UniformGrid>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                <StackPanel>
                  <TextBlock Text="Quick actions" Style="{StaticResource CardTitle}"/>
                  <TextBlock Text="Open the settings most often changed during drafting." Style="{StaticResource CardHelp}" Margin="0,2,0,10"/>
                  <Button Name="GoFieldsButton" Content="Display Fields" Style="{StaticResource PrimaryButton}" Margin="0,0,0,7"/>
                  <Button Name="GoPresetsButton" Content="Preset Profiles" Style="{StaticResource ActionButton}" Margin="0,0,0,7"/>
                  <Button Name="GoAppearanceButton" Content="Popup Appearance" Style="{StaticResource ActionButton}" Margin="0"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- DISPLAY FIELDS -->
        <Grid Name="PageFields" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <StackPanel Name="FieldGroupBar" Grid.Column="0" Orientation="Horizontal">
              <Button Name="GroupCommon" Content="Common" Style="{StaticResource GroupButtonActive}"/>
              <Button Name="GroupHVAC" Content="HVAC / Duct" Style="{StaticResource GroupButton}"/>
              <Button Name="GroupPlumbing" Content="Plumbing / Pipe" Style="{StaticResource GroupButton}"/>
              <Button Name="GroupEquipment" Content="Equipment" Style="{StaticResource GroupButton}"/>
              <Button Name="GroupFabrication" Content="Fabrication" Style="{StaticResource GroupButton}"/>
              <Button Name="GroupQA" Content="QA / Advanced" Style="{StaticResource GroupButton}"/>
            </StackPanel>
            <Grid Grid.Column="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
              <TextBlock Text="{DynamicResource RB.Icon.Search}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource RB.TextMuted}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <TextBox Name="FieldSearchBox" Grid.Column="1" Style="{StaticResource SearchTextBox}" ToolTip="Search every Fab Hover display field"/>
              <Button Name="FieldSearchClear" Grid.Column="2" Style="{StaticResource ActionButton}" Padding="5" Margin="4,0,0,0" ToolTip="Clear search"><TextBlock Text="{DynamicResource RB.Icon.Clear}" FontFamily="Segoe MDL2 Assets" FontSize="11"/></Button>
            </Grid>
          </Grid>

          <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Name="FieldSearchStatus" Text="" Foreground="{DynamicResource RB.TextMuted}" FontSize="8.7" Visibility="Collapsed"/>
          </Grid>

          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Name="FieldSearchEmpty" Background="{DynamicResource RB.CardAlt}" BorderBrush="{DynamicResource RB.Border}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,0,10" Visibility="Collapsed">
                  <StackPanel><TextBlock Text="No matching fields" Style="{StaticResource CardTitle}"/><TextBlock Text="Try a broader term such as size, flow, slope, pressure, material, level, or system." Style="{StaticResource CardHelp}" Margin="0,3,0,0"/></StackPanel>
                </Border>
                <StackPanel Name="FieldsCommon"><TextBlock Text="Common MEP fields" Style="{StaticResource CardTitle}"/><TextBlock Text="Identity, system and location information that applies across HVAC and plumbing." Style="{StaticResource CardHelp}" Margin="0,2,0,8"/><UniformGrid Name="FieldsCommonGrid" Columns="2"/></StackPanel>
                <StackPanel Name="FieldsHVAC" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="HVAC / duct fields" Style="{StaticResource CardTitle}"/><TextBlock Text="Dimensions, airflow, pressure, elevations, slope and duct construction information." Style="{StaticResource CardHelp}" Margin="0,2,0,8"/><UniformGrid Name="FieldsHVACGrid" Columns="2"/></StackPanel>
                <StackPanel Name="FieldsPlumbing" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="Plumbing / piping fields" Style="{StaticResource CardTitle}"/><TextBlock Text="Pipe size, system, flow, velocity, pressure loss, slope, fixture units and hydronic data." Style="{StaticResource CardHelp}" Margin="0,2,0,8"/><UniformGrid Name="FieldsPlumbingGrid" Columns="2"/></StackPanel>
                <StackPanel Name="FieldsEquipment" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="Equipment / terminal fields" Style="{StaticResource CardTitle}"/><TextBlock Text="Air and water flow, electrical, capacity and equipment identification fields." Style="{StaticResource CardHelp}" Margin="0,2,0,8"/><UniformGrid Name="FieldsEquipmentGrid" Columns="2"/></StackPanel>
                <StackPanel Name="FieldsFabrication" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="Fabrication metadata" Style="{StaticResource CardTitle}"/><TextBlock Text="Shop, part, service, material and spool information for fabrication parts." Style="{StaticResource CardHelp}" Margin="0,2,0,8"/><UniformGrid Name="FieldsFabricationGrid" Columns="2"/></StackPanel>
                <StackPanel Name="FieldsQA" Visibility="Collapsed"><TextBlock Text="QA / advanced fields" Style="{StaticResource CardTitle}"/><TextBlock Text="Troubleshooting information. All-parameter modes are intentionally off by default because they do more work." Style="{StaticResource CardHelp}" Margin="0,2,0,8"/><UniformGrid Name="FieldsQAGrid" Columns="2"/></StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- PRESETS -->
        <Grid Name="PagePresets" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Workflow presets" Foreground="#DCEAF2" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Text="Presets change display fields only. Category filters, popup styling and behavior remain untouched." Style="{StaticResource CardHelp}" Margin="0,2,0,0"/>
          </StackPanel>
          <UniformGrid Grid.Row="1" Columns="3" Rows="2">

            <Button Name="PresetGeneral" Style="{StaticResource PresetButton}">
              <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource MiniBadge}" Margin="0,0,11,0"><TextBlock Text="MEP" Style="{StaticResource BadgeText}"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="General" Style="{StaticResource CardTitle}"/><TextBlock Text="Everyday HVAC + plumbing information." Style="{StaticResource CardHelp}" Margin="0,3,0,0"/></StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="A balanced starting point for normal drafting and coordination." Foreground="#9DB5C4" FontSize="9" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Border Style="{StaticResource TagBorder}"><TextBlock Text="SIZE" Foreground="#71C9F4" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="SYSTEM" Foreground="#71C9F4" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="FLOW" Foreground="#71C9F4" FontSize="8"/></Border></StackPanel>
              </Grid>
            </Button>

            <Button Name="PresetHVAC" Style="{StaticResource PresetButton}">
              <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource MiniBadge}" Background="#163A56" BorderBrush="#367FAB" Margin="0,0,11,0"><TextBlock Text="HV" Style="{StaticResource BadgeText}"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="HVAC Fabrication" Style="{StaticResource CardTitle}"/><TextBlock Text="Shop, service and fabrication metadata." Style="{StaticResource CardHelp}" Margin="0,3,0,0"/></StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="For fabrication ductwork, fittings, material and elevation coordination." Foreground="#9DB5C4" FontSize="9" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Border Style="{StaticResource TagBorder}"><TextBlock Text="PART" Foreground="#71C9F4" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="ITEM #" Foreground="#71C9F4" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="BOD/COD/TOD" Foreground="#71C9F4" FontSize="8"/></Border></StackPanel>
              </Grid>
            </Button>

            <Button Name="PresetPlumbing" Style="{StaticResource PresetButton}">
              <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource MiniBadge}" Background="#103B43" BorderBrush="#2A7C82" Margin="0,0,11,0"><TextBlock Text="PL" Style="{StaticResource BadgeText}"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Plumbing" Style="{StaticResource CardTitle}"/><TextBlock Text="Pipe systems, slope and flow." Style="{StaticResource CardHelp}" Margin="0,3,0,0"/></StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="For pipe sizing, hydronic/plumbing systems, pressure and fixture-unit checks." Foreground="#9DB5C4" FontSize="9" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Border Style="{StaticResource TagBorder}"><TextBlock Text="DIAMETER" Foreground="#71C9F4" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="SLOPE" Foreground="#71C9F4" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="FLOW" Foreground="#71C9F4" FontSize="8"/></Border></StackPanel>
              </Grid>
            </Button>

            <Button Name="PresetCoordination" Style="{StaticResource PresetButton}">
              <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource MiniBadge}" Background="#44351D" BorderBrush="#8B7138" Margin="0,0,11,0"><TextBlock Text="CO" Style="{StaticResource BadgeText}"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Coordination" Style="{StaticResource CardTitle}"/><TextBlock Text="Elevations, slope and open ends." Style="{StaticResource CardHelp}" Margin="0,3,0,0"/></StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="Quick vertical coordination values for duct and pipe routing." Foreground="#9DB5C4" FontSize="9" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Border Style="{StaticResource TagBorder}"><TextBlock Text="BOD" Foreground="#E8BC64" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="TOD" Foreground="#E8BC64" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="INVERT" Foreground="#E8BC64" FontSize="8"/></Border></StackPanel>
              </Grid>
            </Button>

            <Button Name="PresetMinimal" Style="{StaticResource PresetButton}">
              <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource MiniBadge}" Background="#293540" BorderBrush="#5A6D7B" Margin="0,0,11,0"><TextBlock Text="MIN" Style="{StaticResource BadgeText}" FontSize="9"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Minimal" Style="{StaticResource CardTitle}"/><TextBlock Text="Smallest useful hover card." Style="{StaticResource CardHelp}" Margin="0,3,0,0"/></StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="Keeps the popup lean when you only need identity and basic geometry." Foreground="#9DB5C4" FontSize="9" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Border Style="{StaticResource TagBorder}"><TextBlock Text="TYPE" Foreground="#9DB5C4" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="SIZE" Foreground="#9DB5C4" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="LENGTH" Foreground="#9DB5C4" FontSize="8"/></Border></StackPanel>
              </Grid>
            </Button>

            <Button Name="PresetEquipment" Style="{StaticResource PresetButton}">
              <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource MiniBadge}" Background="#2A2947" BorderBrush="#5B5A8A" Margin="0,0,11,0"><TextBlock Text="EQ" Style="{StaticResource BadgeText}"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Equipment" Style="{StaticResource CardTitle}"/><TextBlock Text="Mechanical + water equipment." Style="{StaticResource CardHelp}" Margin="0,3,0,0"/></StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="For air/water equipment identity, capacity, electrical and flow information." Foreground="#9DB5C4" FontSize="9" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Border Style="{StaticResource TagBorder}"><TextBlock Text="CFM" Foreground="#B7B5F4" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="GPM" Foreground="#B7B5F4" FontSize="8"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="MODEL" Foreground="#B7B5F4" FontSize="8"/></Border></StackPanel>
              </Grid>
            </Button>
          </UniformGrid>
          <Border Grid.Row="2" Background="#0B263A" BorderBrush="#28516B" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,2,0,0"><TextBlock Text="Tip: presets are intentionally field-only. They will not overwrite your category choices, popup colors or cursor behavior." Foreground="#83A8BC" FontSize="8.7"/></Border>
        </Grid>

        <!-- APPEARANCE -->
        <Grid Name="PageAppearance" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Popup Appearance" Style="{StaticResource CardTitle}" FontSize="13"/><TextBlock Text="Customize the real cursor-following card. These settings do not change which Revit properties are queried." Style="{StaticResource CardHelp}" Margin="0,2,0,12"/>
            <TextBlock Text="Theme" Foreground="#BFD0DB" FontSize="9" Margin="0,0,0,5"/><StackPanel Orientation="Horizontal"><RadioButton Name="ThemeNavy" GroupName="PopupTheme" Content="Navy" Style="{StaticResource ChoiceRadio}"/><RadioButton Name="ThemeGraphite" GroupName="PopupTheme" Content="Graphite" Style="{StaticResource ChoiceRadio}"/><RadioButton Name="ThemeLight" GroupName="PopupTheme" Content="Light" Style="{StaticResource ChoiceRadio}"/></StackPanel>
            <TextBlock Text="Accent color" Foreground="#BFD0DB" FontSize="9" Margin="0,13,0,6"/>
            <WrapPanel>
              <RadioButton Name="AccentBlue" GroupName="PopupAccent" Background="#168CF3" Style="{StaticResource SwatchRadio}" ToolTip="Blue"/><RadioButton Name="AccentAzure" GroupName="PopupAccent" Background="#4DA3FF" Style="{StaticResource SwatchRadio}" ToolTip="Azure"/><RadioButton Name="AccentSky" GroupName="PopupAccent" Background="#35CBEF" Style="{StaticResource SwatchRadio}" ToolTip="Cyan"/><RadioButton Name="AccentTeal" GroupName="PopupAccent" Background="#24B7A5" Style="{StaticResource SwatchRadio}" ToolTip="Teal"/><RadioButton Name="AccentMint" GroupName="PopupAccent" Background="#50B97B" Style="{StaticResource SwatchRadio}" ToolTip="Mint"/><RadioButton Name="AccentGreen" GroupName="PopupAccent" Background="#36A957" Style="{StaticResource SwatchRadio}" ToolTip="Green"/><RadioButton Name="AccentLime" GroupName="PopupAccent" Background="#8FBF4D" Style="{StaticResource SwatchRadio}" ToolTip="Lime"/><RadioButton Name="AccentAmber" GroupName="PopupAccent" Background="#F5A623" Style="{StaticResource SwatchRadio}" ToolTip="Amber"/><RadioButton Name="AccentOrange" GroupName="PopupAccent" Background="#F47A3C" Style="{StaticResource SwatchRadio}" ToolTip="Orange"/>
              <RadioButton Name="AccentCoral" GroupName="PopupAccent" Background="#F0655B" Style="{StaticResource SwatchRadio}" ToolTip="Coral"/><RadioButton Name="AccentRed" GroupName="PopupAccent" Background="#E65454" Style="{StaticResource SwatchRadio}" ToolTip="Red"/><RadioButton Name="AccentRose" GroupName="PopupAccent" Background="#E45BA8" Style="{StaticResource SwatchRadio}" ToolTip="Rose"/><RadioButton Name="AccentPink" GroupName="PopupAccent" Background="#F078C4" Style="{StaticResource SwatchRadio}" ToolTip="Pink"/><RadioButton Name="AccentPurple" GroupName="PopupAccent" Background="#8B6CE8" Style="{StaticResource SwatchRadio}" ToolTip="Purple"/><RadioButton Name="AccentViolet" GroupName="PopupAccent" Background="#6F59C9" Style="{StaticResource SwatchRadio}" ToolTip="Violet"/><RadioButton Name="AccentSteel" GroupName="PopupAccent" Background="#6F9DC7" Style="{StaticResource SwatchRadio}" ToolTip="Steel"/><RadioButton Name="AccentSlate" GroupName="PopupAccent" Background="#8797A5" Style="{StaticResource SwatchRadio}" ToolTip="Slate"/><RadioButton Name="AccentSilver" GroupName="PopupAccent" Background="#B8C5CE" Style="{StaticResource SwatchRadio}" ToolTip="Silver"/>
            </WrapPanel>
            <Border Height="1" Background="#23475F" Margin="0,13,0,10"/>
            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock Text="Background opacity" Foreground="#BFD0DB" VerticalAlignment="Center"/><Slider Name="PopupOpacity" Grid.Column="1" Minimum="55" Maximum="100"/><TextBlock Name="PopupOpacityValue" Grid.Column="2" Foreground="#69C8F5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock Text="Corner radius" Foreground="#BFD0DB" VerticalAlignment="Center"/><Slider Name="PopupCornerRadius" Grid.Column="1" Minimum="0" Maximum="18"/><TextBlock Name="PopupCornerValue" Grid.Column="2" Foreground="#69C8F5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock Text="Text size" Foreground="#BFD0DB" VerticalAlignment="Center"/><Slider Name="PopupTextSize" Grid.Column="1" Minimum="8.5" Maximum="16"/><TextBlock Name="PopupTextValue" Grid.Column="2" Foreground="#69C8F5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock Text="Maximum width" Foreground="#BFD0DB" VerticalAlignment="Center"/><Slider Name="PopupWidth" Grid.Column="1" Minimum="190" Maximum="420"/><TextBlock Name="PopupWidthValue" Grid.Column="2" Foreground="#69C8F5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Border Height="1" Background="#23475F" Margin="0,12,0,8"/>
            <CheckBox Name="PopupShowHeader" Content="Show element heading" Style="{StaticResource FieldToggle}"/><CheckBox Name="PopupShowSubtitle" Content="Show category subtitle" Style="{StaticResource FieldToggle}"/><CheckBox Name="PopupShowIcon" Content="Show category icon" Style="{StaticResource FieldToggle}"/><CheckBox Name="PopupShowAccentBar" Content="Show accent edge" Style="{StaticResource FieldToggle}"/>
          </StackPanel></ScrollViewer></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Popup style preview" Style="{StaticResource CardTitle}"/><TextBlock Text="A lightweight preview of the actual card style — not a fake Revit viewport." Style="{StaticResource CardHelp}" Margin="0,2,0,10"/></StackPanel>
            <Border Grid.Row="1" Background="#121C24" BorderBrush="#36536A" BorderThickness="1" CornerRadius="7" Padding="18"><Grid>
              <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#182630" Offset="0"/><GradientStop Color="#0D151C" Offset="1"/></LinearGradientBrush></Grid.Background>
              <Border Name="PreviewPopup" Width="245" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F20A1725" BorderBrush="#FF168CF3" BorderThickness="1" CornerRadius="8" Padding="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Name="PreviewAccent" Background="#168CF3" CornerRadius="7,0,0,7"/><StackPanel Grid.Column="1" Margin="8,7,9,8"><StackPanel Name="PreviewHeader"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Name="PreviewIconTile" Width="25" Height="25" Background="#143B5D" BorderBrush="#2C6F9E" BorderThickness="1" CornerRadius="4" Margin="0,0,7,0"><TextBlock Text="D" Foreground="#D8EEFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel Grid.Column="1"><TextBlock Name="PreviewTitle" Text="Rectangular Duct" Foreground="#F6FAFD" FontWeight="SemiBold"/><TextBlock Name="PreviewSubtitle" Text="Ducts (Fabrication)" Foreground="#55B8F4" FontSize="8.7"/></StackPanel></Grid><Border Name="PreviewDivider" Height="1" Background="#25425B" Margin="0,6,0,5"/></StackPanel><TextBlock Name="PreviewInfo" Text="Size: 24&quot; x 12&quot;&#x0a;Length: 12' - 0&quot;&#x0a;Service: SA - Supply Air&#x0a;BOD: 10' - 0&quot;&#x0a;System: 1-200&#x0a;Level: Level 2" Foreground="#EAF3F9" FontSize="10.5" LineHeight="14"/></StackPanel></Grid></Border>
            </Grid></Border>
            <TextBlock Grid.Row="2" Text="Changes here affect the real hover popup after Apply &amp; Close." Foreground="#6E8A9C" FontSize="8.5" Margin="0,9,0,0" TextWrapping="Wrap"/>
          </Grid></Border>
        </Grid>

        <!-- BEHAVIOR -->
        <Grid Name="PageBehavior" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel>
            <TextBlock Text="Cursor response" Style="{StaticResource CardTitle}"/><TextBlock Text="Tune how quickly the card follows the cursor and how often Revit is asked for fresh element data." Style="{StaticResource CardHelp}" Margin="0,2,0,12"/>
            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="Cursor tracking" Foreground="#BFD0DB" VerticalAlignment="Center"/><Slider Name="HoverMoveInterval" Grid.Column="1" Minimum="14" Maximum="45"/><TextBlock Name="HoverMoveValue" Grid.Column="2" Foreground="#69C8F5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="Revit read interval" Foreground="#BFD0DB" VerticalAlignment="Center"/><Slider Name="HoverReadInterval" Grid.Column="1" Minimum="28" Maximum="90"/><TextBlock Name="HoverReadValue" Grid.Column="2" Foreground="#69C8F5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="Idle refresh" Foreground="#BFD0DB" VerticalAlignment="Center"/><Slider Name="HoverIdleRefresh" Grid.Column="1" Minimum="350" Maximum="1600"/><TextBlock Name="HoverIdleValue" Grid.Column="2" Foreground="#69C8F5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <TextBlock Text="Quick response presets" Foreground="#9DB5C4" FontSize="9" Margin="0,16,0,6"/>
            <StackPanel Orientation="Horizontal"><Button Name="BehaviorSnappy" Content="Snappy" Style="{StaticResource PrimaryButton}"/><Button Name="BehaviorBalanced" Content="Balanced" Style="{StaticResource ActionButton}"/><Button Name="BehaviorQuiet" Content="Low overhead" Style="{StaticResource ActionButton}"/></StackPanel>
          </StackPanel></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel>
            <TextBlock Text="Popup behavior" Style="{StaticResource CardTitle}"/><TextBlock Text="Control when the card disappears and where it sits relative to the cursor." Style="{StaticResource CardHelp}" Margin="0,2,0,12"/>
            <CheckBox Name="PopupHideNoTarget" Content="Hide when no readable MEP element is under the cursor" Style="{StaticResource FieldToggle}"/>
            <Grid Margin="0,9,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="Hide grace period" Foreground="#BFD0DB" VerticalAlignment="Center"/><Slider Name="PopupHideDelay" Grid.Column="1" Minimum="0" Maximum="250"/><TextBlock Name="PopupHideDelayValue" Grid.Column="2" Foreground="#69C8F5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="Horizontal offset" Foreground="#BFD0DB" VerticalAlignment="Center"/><Slider Name="PopupOffsetX" Grid.Column="1" Minimum="4" Maximum="60"/><TextBlock Name="PopupOffsetXValue" Grid.Column="2" Foreground="#69C8F5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="Vertical offset" Foreground="#BFD0DB" VerticalAlignment="Center"/><Slider Name="PopupOffsetY" Grid.Column="1" Minimum="4" Maximum="60"/><TextBlock Name="PopupOffsetYValue" Grid.Column="2" Foreground="#69C8F5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Border Background="#0B263A" BorderBrush="#28516B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0"><TextBlock Text="For fast daily use, the Snappy preset is a good starting point. Requests are coalesced so a slow Revit frame will not build an ExternalEvent backlog." Foreground="#83A8BC" FontSize="8.8" TextWrapping="Wrap"/></Border>
          </StackPanel></Border>
        </Grid>

        <!-- CATEGORIES -->
        <Grid Name="PageCategories" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="HVAC / Ductwork" Style="{StaticResource CardTitle}"/><TextBlock Text="Native and fabrication air-side categories." Style="{StaticResource CardHelp}" Margin="0,2,0,8"/><StackPanel Name="CategoriesHVAC"/></StackPanel></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,3,0"><StackPanel><TextBlock Text="Plumbing / Piping" Style="{StaticResource CardTitle}"/><TextBlock Text="Pipework, fittings, fixtures and fire protection." Style="{StaticResource CardHelp}" Margin="0,2,0,8"/><StackPanel Name="CategoriesPlumbing"/></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Equipment" Style="{StaticResource CardTitle}"/><TextBlock Text="Mechanical, water and specialty equipment." Style="{StaticResource CardHelp}" Margin="0,2,0,8"/><StackPanel Name="CategoriesEquipment"/></StackPanel></Border>
        </Grid>

        <!-- ADVANCED -->
        <ScrollViewer Name="PageAdvanced" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Parameter coverage strategy" Style="{StaticResource CardTitle}"/><TextBlock Text="Fab Hover first checks stable Revit API properties and built-in parameters for common MEP values. If your office families use custom/shared parameters, the diagnostic All Parameters options can surface any non-empty instance or type parameters on the currently hovered element." Style="{StaticResource CardHelp}" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Diagnostic fields" Style="{StaticResource CardTitle}"/><TextBlock Text="Use these only when you need to discover office-specific parameters; leave them off for daily work." Style="{StaticResource CardHelp}" Margin="0,2,0,8"/><StackPanel Name="AdvancedDiagnosticFields"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource RB.Footer}" BorderBrush="{DynamicResource RB.Border}" BorderThickness="0,1,0,0" Padding="18,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal"><Button Name="ResetButton" Content="Reset defaults" Style="{StaticResource ActionButton}"/><TextBlock Text="Settings are stored per Windows user" Foreground="{DynamicResource RB.TextFaint}" FontSize="8.5" VerticalAlignment="Center" Margin="4,0,10,0"/><TextBlock Text="•" Foreground="{DynamicResource RB.TextFaint}" FontSize="8.5" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Name="FooterStatus" Text="Settings saved" Foreground="{DynamicResource RB.TextFaint}" FontSize="8.5" VerticalAlignment="Center"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Name="CancelButton" Content="Cancel" Width="86" Style="{StaticResource ActionButton}"/><Button Name="SaveButton" Content="Apply &amp; Close" Width="120" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0"/></StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>