<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STEELTOOLS | Sloped Joist Supports" Height="780" Width="646"
        MinHeight="590" MinWidth="590" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#111D2D" Foreground="#F0F6FB" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0,4,0,9"/>
      <Setter Property="Background" Value="#F1F6FA"/><Setter Property="Foreground" Value="#182736"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="7,5"/>
      <Setter Property="Background" Value="#F1F6FA"/><Setter Property="Foreground" Value="#182736"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Height" Value="39"/><Setter Property="Padding" Value="13,8"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22,15,22,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="STEELTOOLS   /   HANGER SUPPORTS" Foreground="#5CC6E9" FontWeight="Bold" FontSize="11"/>
      <TextBlock Text="Sloped Joist Groups" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,2"/>
      <TextBlock x:Name="session_title" Foreground="#B5D0DF" FontSize="12"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#1B334C" BorderBrush="#375F7B" BorderThickness="1" CornerRadius="5" Padding="11" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="START BOS + END BOS OR ROOF PITCH" FontWeight="Bold" Foreground="#8FE2FF"/>
        <TextBlock Text="One group can slope along joists and change elevation across the row. BOS is supplied by you, NOT read from the protected NWD. Always verify against steel documentation." FontSize="11" Foreground="#DAE8F2" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="1,0,12,9">
        <TextBlock Text="AREA NAME" Foreground="#B7CDDC" FontWeight="Bold" FontSize="11"/>
        <TextBox x:Name="group_text" Margin="0,4,0,11"/>
        <TextBlock Text="JOIST LAYOUT" Foreground="#B7CDDC" FontWeight="Bold" FontSize="11"/>
        <ComboBox x:Name="mode_combo"/>
        <TextBlock Text="NATIVE STRUCTURAL FRAMING TYPE" Foreground="#B7CDDC" FontWeight="Bold" FontSize="11"/>
        <ComboBox x:Name="beam_combo"/>
        <TextBlock Text="REFERENCE REVIT LEVEL" Foreground="#B7CDDC" FontWeight="Bold" FontSize="11"/>
        <ComboBox x:Name="level_combo"/>
        <TextBlock Text="BOS DATUM" Foreground="#B7CDDC" FontWeight="Bold" FontSize="11"/>
        <ComboBox x:Name="zmode_combo"/>
        <Border Background="#243A51" CornerRadius="4" Padding="11" Margin="0,4,0,12">
          <StackPanel>
            <TextBlock Text="SLOPE ALONG JOIST" FontWeight="Bold" Foreground="#8FE2FF" FontSize="11"/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="START BOS (required)" FontSize="11" Foreground="#C0D7E5" Margin="0,0,0,5"/>
                <TextBox x:Name="bos_start_text"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="END BOS (optional)" FontSize="11" Foreground="#C0D7E5" Margin="0,0,0,5"/>
                <TextBox x:Name="bos_end_text"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="OR enter signed roof rise in inches per horizontal foot (e.g. 2 = rise 2&quot; per foot). Leave END BOS blank when using pitch." FontSize="11" Foreground="#C0D7E5" Margin="0,9,0,4"/>
            <TextBox x:Name="pitch_text" Width="155" HorizontalAlignment="Left"/>
            <TextBlock Text="For LEVEL joists, leave both END BOS and roof rise blank." FontSize="11" Foreground="#A4BECF" Margin="0,7,0,0"/>
          </StackPanel>
        </Border>
        <TextBlock Text="PARALLEL ARRAY" FontWeight="Bold" Foreground="#B7CDDC" FontSize="11"/>
        <Grid Margin="0,6,0,9">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Number of joists" FontSize="11" Foreground="#B7CDDC" Margin="0,0,0,5"/>
            <TextBox x:Name="count_text"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="BOS step per joist at START" FontSize="11" Foreground="#B7CDDC" Margin="0,0,0,5"/>
            <TextBox x:Name="step_start_text"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="BOS step per joist at END (blank = same as START step)" Foreground="#B7CDDC" FontSize="11" Margin="0,0,0,5"/>
        <TextBox x:Name="step_end_text" Width="198" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <Border Background="#1D3851" CornerRadius="4" Padding="11">
          <StackPanel>
            <TextBlock Text="HOW IT WORKS" Foreground="#8FE2FF" FontWeight="Bold" FontSize="11"/>
            <TextBlock x:Name="pick_help" Foreground="#D2E5F0" FontSize="11" Margin="0,5,0,6"/>
            <TextBlock Text="Creates straight sloping support members and checks the physical underside at 20%, 50%, and 80% span. Tapered/kinked joist chords require separate segments or manual verification." Foreground="#B5CFDD" FontSize="11"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" BorderBrush="#314F6B" BorderThickness="0,1,0,0" Padding="0,13,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="cancel_button" Content="Cancel" Width="100" Background="#374C61" Foreground="White" Margin="0,0,10,0"/>
        <Button x:Name="run_button" Content="Lay Out Joists" Width="182" Background="#26B6DA" Foreground="#0B202E" FontWeight="Bold"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
