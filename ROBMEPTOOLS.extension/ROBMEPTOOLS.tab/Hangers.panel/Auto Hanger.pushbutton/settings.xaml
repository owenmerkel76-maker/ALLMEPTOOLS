<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ROBMEPTOOLS | Auto Hanger — preview" Width="925" Height="750" MinWidth="850" MinHeight="610" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#111B2B" Foreground="#E8EEF8" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E8EEF8" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="29" />
      <Setter Property="Margin" Value="0,4,0,10" />
      <Setter Property="Foreground" Value="#182638" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="29" />
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="Foreground" Value="#172538" />
      <Setter Property="Background" Value="White" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="AUTO HANGER" FontWeight="Bold" FontSize="22" Foreground="#9DD7FF" />
      <TextBlock Text="FABRICATION DUCT  /  PREFERRED IFC + ROOF FALLBACK" FontSize="11" Foreground="#9AB3CE" Margin="0,4,0,0" />
      <Border Height="1" Background="#35516F" Margin="0,13,0,0" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Foreground="#9AB3CE" TextWrapping="Wrap" FontSize="11" Text="SMACNA-informed layout is preliminary, not a hanger/anchor load certification. IFC framing takes priority over native deck. Geometry-sized rods are labeled UNATTACHED until you use Attach to Structure; placement is not SMACNA-approved anchorage." />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
        <Button x:Name="cancelButton" Content="Cancel" Width="100" Height="33" Margin="0,0,10,0" Background="#32455D" Foreground="White" />
        <Button x:Name="placeButton" Content="Run selected mode" Width="156" Height="33" Background="#2A7BBF" Foreground="White" FontWeight="Bold" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,6,0">
        <Border BorderBrush="#35516F" BorderThickness="1" CornerRadius="5" Background="#19283C" Padding="12" Margin="0,17,0,0">
          <StackPanel>
            <CheckBox x:Name="previewCheck" Content="Preview only — do not change the model" Foreground="#FFFFFF" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#A6BAD0" TextWrapping="Wrap" Text="Clearing Preview creates verified structural hangers when Revit connects them. With DRAFT enabled, only independently measured IFC/roof-targeted rods may be kept UNATTACHED and marked. No draft counts as approved support." />
          </StackPanel>
        </Border>
        <Border BorderBrush="#35516F" BorderThickness="1" CornerRadius="5" Background="#19283C" Padding="12" Margin="0,14,0,0">
          <StackPanel>
            <CheckBox x:Name="singleTestCheck" Foreground="White" FontWeight="SemiBold" Content="Single hanger test — choose one duct and click a station (always rolled back)" />
            <TextBlock Foreground="#A6BAD0" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8" Text="Overrides Preview for one temporary test. Reports creation, BOTH rods, targets and clearance separately. No hangers are kept. Clearance stays enabled; unreadable references can be reviewed first." />
          </StackPanel>
        </Border>
        <TextBlock Text="FABRICATION HANGERS — SERVICE BY SERVICE" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,9" />
        <TextBlock Foreground="#A6BAD0" FontSize="11" TextWrapping="Wrap" Text="Only services used by selected duct are shown. Each drop-down contains hanger buttons from THAT duct service only. Empty services are skipped. Verify each automatic choice." />
        <StackPanel x:Name="serviceRows" Margin="0,3,0,10" />
        <TextBlock Text="Layout limits — verify against your approved schedule" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,7" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Max spacing cap (ft)" />
            <TextBox x:Name="spacingBox" Text="8.0" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="End/turn target (ft)" />
            <TextBox x:Name="offsetBox" Text="1.5" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Max rod length (ft)" />
            <TextBox x:Name="rodBox" Text="20.0" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
        <Border BorderBrush="#8E7848" BorderThickness="1" CornerRadius="5" Background="#352B20" Padding="12" Margin="0,17,0,8">
          <StackPanel>
            <CheckBox x:Name="draftCheck" Foreground="White" FontWeight="SemiBold" Content="Keep UNATTACHED hangers sized to selected IFC beams/joists first, then roof deck" />
            <TextBlock Foreground="#F3DB9C" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Text="DRAFT / UNATTACHED is NOT structural attachment. Each rod is independently measured to the exact selected IFC framing solid or roof/deck underside (including slopes). If any rod cannot be measured, the hanger is not kept. No native attachment is claimed. Use Repair Draft Rods to fix previous drafts." />
          </StackPanel>
        </Border>
        <TextBlock Margin="0,5,0,0" FontSize="11">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="Duct clearance: OFF — review Advanced settings" />
              <Setter Property="Foreground" Value="#F3DB9C" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=sideTapCheck}" Value="True">
                  <Setter Property="Text" Value="Duct clearance: ON" />
                  <Setter Property="Foreground" Value="#B2C9DF" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Margin="0,5,0,0" FontSize="11">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="Rod clearance: OFF — review Advanced settings" />
              <Setter Property="Foreground" Value="#F3DB9C" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=rodClashCheck}" Value="True">
                  <Setter Property="Text" Value="Rod clearance: ON" />
                  <Setter Property="Foreground" Value="#B2C9DF" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Margin="0,5,0,0" FontSize="11">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="Experimental fitting fallback: OFF — review Advanced settings" />
              <Setter Property="Foreground" Value="#F3DB9C" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=fittingCheck}" Value="True">
                  <Setter Property="Text" Value="Experimental fitting fallback: ON" />
                  <Setter Property="Foreground" Value="#B2C9DF" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Expander Header="Advanced settings — hardware, clearance and diagnostics" IsExpanded="False" Margin="0,14,0,0" Foreground="White">
          <StackPanel Margin="8,6,8,8">
            <Border Background="#19283C" BorderBrush="#35516F" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,2,0,10">
              <StackPanel>
                <CheckBox x:Name="largeRectCheck" Foreground="White" FontWeight="SemiBold" Content="Use each service's Trapeze button for rectangular duct above specified width" />
                <TextBlock Foreground="#B2C9DF" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,6" Text="Only when enabled. Choose the Trapeze button separately for SA/RA/EA/TA above. Width must be based on your approved hanger schedule." />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Threshold (in)" Margin="0,8,12,0" />
                  <TextBox x:Name="largeRectWidthBox" Text="48" Width="90" />
                </StackPanel>
              </StackPanel>
            </Border>
            <CheckBox x:Name="fittingCheck" Foreground="White" FontWeight="SemiBold" Margin="0,13,0,0" Content="Try straight extensions of 2-port elbows/angles when a run has no legal straight station" />
            <TextBlock Foreground="#A6BAD0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Text="Experimental fallback: candidate fittings are shown as unverified in Preview. Placement tests Revit-approved positions with rollback, native host and rod verification. Must inspect actual extension and spacing." />
            <CheckBox x:Name="sideTapCheck" Content="Avoid inline accessories, side taps and nearby branch duct using 3D clearance screening" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,16,0,0" />
            <TextBlock FontSize="11" Foreground="#A6BAD0" TextWrapping="Wrap" Margin="0,5,0,0" Text="Screens neighboring native duct, pipe, and fittings; moves stations away from 3D collision envelopes. Rechecks maximum support spacing and flags unresolved runs." />
            <CheckBox x:Name="rodClashCheck" Content="Reject newly placed hangers whose rods may intersect nearby native MEP" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock FontSize="11" Foreground="#A6BAD0" TextWrapping="Wrap" Margin="0,5,0,0" Text="Conservative rod-envelope check after creation (two-sided where rod-end orientation is ambiguous). Includes native fabrication pipe/duct, fittings, accessories, and mechanical equipment. A rejected hanger is rolled back and logged. Linked MEP and exact hardware solid collisions still need a 3D review." />
            <CheckBox x:Name="referenceReviewCheck" Foreground="White" Content="Review unreadable drawing / coordination references for this run" />
            <TextBlock Foreground="#A6BAD0" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Text="Nothing is preselected. Check only objects you know are background or duplicate references. Known solids/meshes, MEP and approved structural targets are not offered for exclusion." />
            <Border Background="#19283C" BorderBrush="#35516F" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,13,0,0">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Applied size-based spacing schedule (before overall cap)" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#B2C9DF" Margin="0,5,0,0" Text="RECT (W+H): up to 72 in: 8 ft / 72-120 in: 5 ft / above 120 in: 4 ft.  ROUND: up to 24 in: 10 ft / 24-36 in: 8 ft / 36-60 in: 6 ft / 60-96 in: 4 ft.  OVAL: 4 ft. All are reduced by the cap above." />
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#E3C991" Margin="0,5,0,0" Text="These are preliminary size-based conservative planning limits, NOT standalone SMACNA-compliant distances. Rectangular Table 5-1 also depends on strap/rod size and loading. Verify approved service-specific hardware, insulation and anchorage." />
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
