<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROB MEP  |  Structural Target Selection"
        Width="875" Height="710" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#111B2B" Foreground="#E8EEF8"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EEF8" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EEF8" /></Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="#E8EEF8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="2,4" />
      <Setter Property="IsExpanded" Value="True" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#32455D" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="13,4" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#182638" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Height" Value="28" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="STRUCTURAL TARGET SELECTION" FontWeight="Bold" FontSize="22" Foreground="#9DD7FF" />
      <TextBlock Text="APPROVE IFC FRAMING / CHOOSE FALLBACK SURFACES" FontSize="11" Foreground="#9AB3CE" Margin="0,5,0,0" />
      <TextBlock Text="Choose beams/joists for the rods and optional roof/deck fallback. Duct and hanger-service choices stay in the normal Auto Hanger workflow."
                 TextWrapping="Wrap" Foreground="#B2C9DF" Margin="0,10,0,0" />
      <Border BorderBrush="#8E7848" BorderThickness="1" Background="#352B20" CornerRadius="4" Padding="9" Margin="0,11,0,0">
        <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="warningText" Foreground="#F3DB9C" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
        <Button x:Name="allFramingButton" Content="Select All Framing" Margin="0,0,9,0" />
        <Button x:Name="clearButton" Content="Clear Selection" Margin="0,0,9,0" />
        <Button x:Name="pickButton" Content="Select in Model" />
      </StackPanel>
      <CheckBox x:Name="showOtherCheck" Content="Show custom / unclassified IFC types (manual approval)" Margin="0,0,0,8" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Border Background="#19283C" BorderBrush="#35516F" BorderThickness="1" CornerRadius="5" Padding="11">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="Structural targeting priority" Margin="0,0,0,5" />
              <ComboBox x:Name="priorityBox">
                <ComboBoxItem Content="Preferred framing first, then fallback" />
                <ComboBoxItem Content="Preferred framing only" />
                <ComboBoxItem Content="Fallback surfaces only" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="Maximum rod length (ft)" Margin="0,0,0,5" />
              <TextBox x:Name="maxRodBox" Height="28" Padding="5,3" Foreground="#172538" Background="White" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Role used by direct member picks" Margin="0,0,0,5" />
              <ComboBox x:Name="pickRoleBox">
                <ComboBoxItem Content="Preferred framing" />
                <ComboBoxItem Content="Fallback surface" />
              </ComboBox>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="countText" Foreground="#9DD7FF" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
          <TextBlock Text="Fallback is used when no approved framing is reachable. Bounds only screen candidates; unreadable or unsupported geometry cannot size rods. Correctly measured rods may remain unattached for manual attachment."
                     Foreground="#B2C9DF" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13,0,0">
        <Button x:Name="cancelButton" Content="Cancel" Width="100" Margin="0,0,10,0" />
        <Button x:Name="confirmButton" Content="Use Approved Structure" Background="#2A7BBF" FontWeight="Bold" Width="205" />
      </StackPanel>
    </StackPanel>
    <Border BorderBrush="#35516F" BorderThickness="1" Background="#19283C" CornerRadius="5">
      <TreeView x:Name="modelTree" Background="Transparent" BorderThickness="0"
                Foreground="#E8EEF8" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Border>
  </DockPanel>
</Window>
